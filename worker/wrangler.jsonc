{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-wayfarers",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // only the custom domain: the workers.dev URL would expose the account subdomain
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "pixelwayfarers.com", "custom_domain": true },
    { "pattern": "www.pixelwayfarers.com", "custom_domain": true }
  ],
  // pixelating a 1024px image takes a few hundred ms of CPU (Workers Paid)
  "limits": { "cpu_ms": 30000 },
  "ai": { "binding": "AI" },
  // marketing site; the Worker runs first only to redirect www and to serve /admin
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "r2_buckets": [{ "binding": "ART", "bucket_name": "pixel-wayfarers" }],
  // Pixel Wayfarers on NEAR (src/near.ts). Secret STUDIO_FULFIL_KEY: a key of NEAR_STUDIO that may only call fulfil.
  "vars": { "NEAR_NETWORK": "testnet", "NEAR_COLLECTION": "pixel-wayfarers.testnet", "NEAR_STUDIO": "wayfarers-studio.testnet" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "workflows": [
    { "name": "pixel-wayfarers-generate", "binding": "GENERATE", "class_name": "GenerateToken" }
  ]
  // secret: ADMIN_PASSWORD  (wrangler secret put ADMIN_PASSWORD)
}
